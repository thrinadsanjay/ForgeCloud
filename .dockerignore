# Keep the build context small and dev state out of the image.

# Host / source tree deps (image packs .build/ from ./build.sh instead)
frontend/node_modules
backend/node_modules
frontend/dist
backend/dist

# Runtime state from the dev machine
backend/data
data

# Secrets & local env
.env
**/.env
!.env.example

# Logs, pids, scratch
logs
*.log
*.pid

# Tooling / VCS / docs
.git
.gitignore
.claude
*.md
start.sh
stop.sh
status.sh
docker-entrypoint.sh

# Editor / OS cruft
.vscode
.idea
.DS_Store
Thumbs.db
