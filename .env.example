# Forge — runtime configuration template.
#
# Copy to backend/.env for local dev, or pass these as container env vars.
# Most settings can also be changed via the in-app Settings page (stored in PostgreSQL).

# --- Database (required) ---
DATABASE_URL=postgresql://ssp:changeme@localhost:5432/proxmox_ssp
DB_PASSWORD=changeme

# --- Server ---
PORT=4100

# --- Auth ---
JWT_SECRET=
JWT_EXPIRY=8h
FORGE_ADMIN_PASSWORD=
# Legacy alias (still accepted): SSP_ADMIN_PASSWORD=

# --- Proxmox ---
PROXMOX_HOST=
PROXMOX_PORT=8006
PROXMOX_NODE=
# Password auth (default)
PROXMOX_USE_API_TOKEN=false
PROXMOX_USERNAME=root@pam
PROXMOX_PASSWORD=
# API token auth — set PROXMOX_USE_API_TOKEN=true and fill both below
# Token ID format: user@realm!tokenname  (e.g. root@pam!forge-portal)
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_VERIFY_SSL=false

# --- VM defaults ---
VM_SSH_PASSWORD=

# --- Ansible guest setup (Forge as controller; Linux only) ---
# When ANSIBLE_ENABLED=true, post-boot setup uses ansible/roles/initial_setup
# instead of cloud-init package installs + SSH shell scripts.
# Supported guests: Debian, Ubuntu, RHEL/Rocky/Alma/CentOS, SUSE/openSUSE.
# Windows is not supported yet.
ANSIBLE_ENABLED=false
ANSIBLE_BOOTSTRAP_CLOUDINIT=true
ANSIBLE_SERVICE_USER=forge
ANSIBLE_SERVICE_PASSWORD=
ANSIBLE_ADMIN_PUBKEY=
ANSIBLE_FORGE_PUBLIC_KEY=
ANSIBLE_FORGE_PRIVATE_KEY=
ANSIBLE_REMOVE_FORGE_KEY=true
# ANSIBLE_ROOT=/app/ansible

# --- Proxmox snippets (cloud-init user-data uploads) ---
SNIPPET_STORAGE=local

# --- ServiceNow ITSM ---
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_VERIFY_TLS=false
SERVICENOW_HTTP_TIMEOUT_MS=15000
SERVICENOW_CATALOG_ENABLED=true
SERVICENOW_CATALOG_ITEM_SYS_ID=
SERVICENOW_ASSIGNMENT_GROUP_SYS_ID=
SERVICENOW_REQUESTED_FOR_SYS_ID=
SERVICENOW_OPENED_BY_SYS_ID=
SERVICENOW_CALLER_SYS_ID=
SERVICENOW_INCIDENTS_ENABLED=true
SERVICENOW_USER_LOOKUP_ENABLED=true
SERVICENOW_CMDB_ENABLED=true
SERVICENOW_CMDB_CLASS=cmdb_ci_server
# Inbound dual-approval webhook (ServiceNow / n8n → Forge).
# Header: X-Forge-Webhook-Secret, or Authorization: Bearer <secret>,
# or X-Forge-Signature: sha256=<hmac>. Falls back to N8N_WEBHOOK_SECRET.
SERVICENOW_WEBHOOK_SECRET=

# --- n8n / workflow webhooks ---
N8N_WEBHOOK_ENABLED=true
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_VERIFY_TLS=false
N8N_HTTP_TIMEOUT_MS=10000

# --- AI assistant (Forge Assist) ---
# Provider: gemini | openai | anthropic | openrouter | ollama
AI_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (ChatGPT)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenRouter (multi-model marketplace)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Ollama (local OpenAI-compatible API)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2

# --- Approval policy ---
AUTO_APPROVE_DEPLOYMENTS=false
APPROVAL_CPU_THRESHOLD=2
APPROVAL_MEMORY_GB_THRESHOLD=4
APPROVAL_DISK_GB_THRESHOLD=50

# --- OIDC SSO (any OpenID Connect provider) ---
# Issuer = discovery base URL without /.well-known/openid-configuration
# Entra example: https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5273/auth/oidc/callback
OIDC_SCOPES=openid profile email
# Legacy Entra aliases (still accepted if OIDC_* unset):
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI=

# --- Public URL for IaC export templates ---
FORGE_PUBLIC_URL=
# Legacy alias (still accepted): SSP_PUBLIC_URL=

# --- Deployment retention (optional) ---
# Soft-archive terminal jobs/requests after 7 days; hard-delete archived after 1 year.
# DEPLOYMENT_ARCHIVE_AFTER_MS=604800000
# DEPLOYMENT_PURGE_AFTER_MS=31536000000
# DEPLOYMENT_ARCHIVE_INTERVAL_MS=900000
